# Plantilla de configuración del cliente (Vite).
# Para desarrollo local es opcional: sin este archivo se usa http://localhost:5128/api.
# Para cambiarla, copia este archivo como client/.env.local (git lo ignora).
# Solo las variables que empiezan por VITE_ llegan al navegador: NUNCA pongas secretos aquí.
# El valor se incrusta al compilar (npm run build): cambiarlo después exige volver a compilar.

# URL de la API, terminada en /api y sin barra final
VITE_API_URL=http://localhost:5128/api
