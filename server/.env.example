# Plantilla de configuración del servidor.
# Copia este archivo como server/.env y completa los valores. server/.env NO se versiona.
# Explicación de cada variable: docs/03-configuracion.md
# Las líneas comentadas muestran el valor por defecto; descoméntalas solo si necesitas cambiarlo.

# --- Servidor ---
# development | production (test lo define Jest)
NODE_ENV=development
PORT=5128
# Solo se usa para mostrar URLs en logs y Swagger
HOST=127.0.0.1

# --- CORS (en development se permite cualquier origen) ---
# CORS_ENABLED=true
# Orígenes permitidos, separados por comas y sin barra final
CORS_ORIGIN=http://localhost:5173
# CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS_CREDENTIALS=true

# --- Base de datos SQL Server (obligatorias) ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=nombre_base_datos
DB_USER=usuario_db
DB_PASS=cambiar_esta_contrasena
TBL_ASESORES=asesores_api
# SQL Server local o en Docker: DB_ENCRYPT=false y DB_TRUST_SERVER_CERT=true
# Azure SQL: DB_ENCRYPT=true y DB_TRUST_SERVER_CERT=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# DB_CONN_TIMEOUT=30000
# DB_REQ_TIMEOUT=30000
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_POOL_IDLE=30000

# --- Carga de archivos ---
# Tamaño máximo en bytes (10 MB). Si lo cambias, cambia también el cliente.
# MAX_FILE_SIZE=10485760
# ALLOWED_EXTENSIONS=.csv
# UPLOAD_DIR=uploads
# UPLOAD_CLEANUP_ENABLED=false
# UPLOAD_RETENTION_DAYS=30
# UPLOAD_CLEANUP_INTERVAL=24

# --- Lectura del CSV ---
# Separador forzado. Vacío = se detecta en la cabecera, con preferencia por ;
# CSV_DELIMITER=;
# Usa latin1 si los archivos vienen de Excel en Windows y ves tildes rotas
# CSV_ENCODING=utf-8
# SKIP_EMPTY_LINES=true
# CSV_HEADER_REQUIRED=true
# CSV_TRIM_VALUES=true

# --- Logs ---
# error | warn | info | http | debug | trace
# LOG_LEVEL=debug
# LOG_TO_FILE=false
# LOG_DIR=logs
