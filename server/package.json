{
  "name": "datadock-server",
  "description": "API de DataDock: ingesta de archivos CSV a SQL Server con validación por esquema",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon src/index.js --exec babel-node",
    "build": "babel src -d dist",
    "start": "node dist",
    "test": "jest",
    "lint": "eslint . --max-warnings 0"
  },
  "nodemonConfig": {
    "//": "Solo src/: los archivos que genera la app (uploads/, logs/) no deben reiniciar el servidor",
    "watch": [
      "src"
    ],
    "ext": "js,json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.13.3",
    "mssql": "^12.7.2",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.11",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.14",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0"
  }
}
